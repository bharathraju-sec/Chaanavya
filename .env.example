# Copy to .env.local for local development. `npm run check:env` validates the settings and prints
# names only, never values. Staging and production set these in the hosting secret store.

# development | staging | production. Defaults from VERCEL_ENV (preview = staging), else development.
APP_ENV=
# Postgres. Locally the compose database (`npm run db:up`, development-only credentials).
# Required in staging and production.
DATABASE_URL=postgresql://chaanavya:chaanavya_dev_only@127.0.0.1:54329/chaanavya_dev

# Sign-in. At least 32 random characters, required in staging and production; generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public site URL, for example http://localhost:3000 locally or https://chaanavya.in in production.
BETTER_AUTH_URL=
# Admin workspace on its own host, origin only. Production: https://admin.chaanavya.in
# Locally, http://admin.localhost:3000 works without DNS changes; leave empty to use /admin instead.
ADMIN_URL=

# Payments (planned, Stage 14). test outside production, live only in production; key prefixes are
# checked against it. Never put a secret in a NEXT_PUBLIC_ name.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public. Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Loads only after cookie consent; leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Private. Anthropic API key for the shop chat (Claude Haiku 5.5). Leave empty to hide the chat.
# Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=
# debug | info | warn | error
LOG_LEVEL=info

# Services (Stage 07). The web host forwards /api/* to the API; the API and worker own the database.
# Web host: the API's origin. Required in staging and production (https). Locally defaults to
# http://127.0.0.1:4000, where `npm run dev:api` listens.
API_URL=
# Web host and API: shared key the web host proves itself with. At least 32 random characters,
# required in staging and production; never sent to browsers. Locally a development key is used.
API_INTERNAL_KEY=
# Worker: the web host's origin, to refresh cached catalogue pages after a publish or stock change.
# Locally defaults to http://127.0.0.1:3000. Without it the shop still refreshes within 60 seconds.
WEB_URL=
# API, TEMPORARY, development only: off lets staff use the admin with a password alone (no authenticator),
# until real staff accounts exist. Ignored outside development, and the API refuses to start in staging or
# production with it set to off. Leave it empty (or on) for the real rule: every staff sign-in uses two-factor.
ADMIN_TWO_FACTOR=
# API: listening port (default 4000).
API_PORT=
# API and worker: database connections per process (1 to 50, default 10).
DATABASE_POOL_MAX=
# Worker: health probe port (default 4001).
WORKER_HEALTH_PORT=

# Product photos (Stage 08): an S3-compatible bucket (AWS S3, Cloudflare R2, ...). Locally the compose
# `media` service is used when these are empty. API and worker:
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# Only for services other than AWS S3, for example https://<account>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Web host and API: where approved photos are served from, ending in /, for example https://media.chaanavya.in/
MEDIA_PUBLIC_BASE_URL=
# Web host: the origin of the bucket's signed upload links (admin pages may upload there).
MEDIA_UPLOAD_ORIGIN=
