SHOPIFY_STORE_DOMAIN=0muehv-am.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
# Local testing only. Never enable this for the production storefront.
SHOPIFY_USE_MOCK=false
# Server only. Newsletter sign-ups: Dev Dashboard app (write_customers, read_customers) installed on the store.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Alternative for a legacy custom app with a permanent Admin API token.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Public. Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Loads only after cookie consent; leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Private. Anthropic API key for the shop chat (Claude Haiku 5.5). Leave empty to hide the chat in production.
# Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=
