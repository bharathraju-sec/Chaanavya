# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and workspaces)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example


# project documentation (kept locally, not versioned or deployed)
/docs/

# Playwright MCP screenshots and page snapshots
.playwright-mcp/

# local upgrade workspace (copied back into the main folder when the upgrade is done)
/backup/

# local database dumps from `npm run db:backup` (may contain personal data once real data exists)
/backups/

# Prisma client, generated by `npm install` (postinstall) or `npm run db:generate`
/apps/api/src/db/generated/

# API and worker builds (Stage 07)
/apps/*/dist/
