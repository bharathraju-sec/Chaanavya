{
  "name": "@chaanavya/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Chaanavya background worker (Stage 07): durable scheduled jobs against the database. Plain TypeScript run by Node; no build step.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=../../.env.local src/main.ts",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=../../.env.local --watch src/main.ts"
  },
  "dependencies": {
    "@chaanavya/api": "*",
    "@chaanavya/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
