// Chaanavya commerce schema (Stage 04). Source contracts: lib/modules/contracts/ (Stage 02).
//
// Conventions
// - IDs: time-ordered UUIDs generated by Prisma (uuid v7), stored as Postgres uuid.
// - Money: integer paise in bigint columns named *_paise, with a char(3) currency (INR only for now).
//   Never floats. lib/db/money.ts converts to the number paise used by the contracts.
// - Status enums use exactly the values in lib/modules/contracts/state-machines.ts
//   (tests/integration/database/schema.test.mjs fails if they drift).
// - Shopify and provider IDs live in separate nullable unique columns, for migration and
//   reconciliation only.
// - Deletes are restricted by default. Commerce records are archived, not deleted.
// - CHECK constraints, partial unique indexes and append-only triggers that Prisma cannot express
//   are added by hand in the migration SQL (see prisma/README.md).
// - No card data, CVV, passwords or provider secrets are stored. Sessions store token hashes only.

generator client {
  provider               = "prisma-client"
  output                 = "../src/db/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums (values must match lib/modules/contracts)

enum StaffRole {
  OWNER
  ADMIN
  STAFF
}

enum ActorKind {
  customer
  guest
  staff
  system
  provider
}

enum ProductStatus {
  draft
  active
  archived
}

/// How couriers must handle a product (Stage 08). Null on a product means nobody has reviewed it yet,
/// and publishing is refused until someone does.
enum ShippingRestriction {
  none
  /// Alcohol-based fragrance: restricted for air transport by most couriers.
  fragrance_liquid
  /// Jewellery: high value, needs declared value and insured shipping.
  jewellery_high_value
}

/// Product photos are private until approved (Stage 08).
enum MediaStatus {
  pending
  approved
  rejected
}

enum MovementType {
  receipt
  correction
  reservation
  release
  allocation
  fulfilment
  return
  write_off
}

/// Physical stock count (Stage 09): counted, then approved with every discrepancy accepted.
enum StocktakeStatus {
  draft
  submitted
  approved
  cancelled
}

enum ReservationStatus {
  active
  allocated
  released
  fulfilled
}

enum PromotionKind {
  percent
  fixed_amount
}

enum OrderStatus {
  pending_payment
  needs_review
  confirmed
  completed
  cancelled
}

enum FulfilmentStatus {
  unfulfilled
  packing
  packed
  handed_over
  cancelled
}

enum PaymentProvider {
  razorpay
  phonepe
}

enum PaymentMode {
  test
  live
}

enum PaymentStatus {
  created
  authorized
  captured
  pending_reconciliation
  failed
  expired
  partially_refunded
  refunded
}

/// Stage 14.10: where a webhook event is in its processing (payment_webhook_inbox).
enum WebhookInboxStatus {
  received
  processing
  processed
  failed
}

enum ProviderEventOutcome {
  applied
  duplicate
  conflict
  ignored
}

enum RefundStatus {
  requested
  processing
  succeeded
  failed
  rejected
}

enum CourierProvider {
  shiprocket
}

enum ShipmentStatus {
  booking_requested
  booked
  pickup_scheduled
  picked_up
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  rto_initiated
  rto_delivered
  cancelled
  lost
}

enum ReturnStatus {
  requested
  under_review
  pickup_initiated
  returned
  inspected
  approved
  rejected
  refunded
  withdrawn
  closed
}

// ---------------------------------------------------------------------------------------------
// Identity (Stage 05). User, AuthSession, Account, Verification, TwoFactor and RateLimit follow
// Better Auth's schema (field names are what Better Auth reads; columns are snake_case).
// GuestSession is ours: an anonymous shopper's cart and orders, never an identity.

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-case; unique among users.
  email            String    @unique
  /// Set by Better Auth once the address is proven (email code sign-in).
  emailVerified    Boolean   @default(false) @map("email_verified")
  name             String    @default("")
  image            String?
  /// Better Auth two-factor plugin: TOTP enrolled and verified.
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  /// E.164, for example +919876543210.
  phone            String?
  phoneVerifiedAt  DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  /// A disabled user keeps their history but cannot use any session (lib/auth/guards.ts).
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles      Role[]           @relation("RoleHolder")
  granted    Role[]           @relation("RoleGranter")
  sessions   AuthSession[]
  accounts   Account[]
  twoFactors TwoFactor[]
  profile    CustomerProfile?
  addresses  Address[]
  carts      Cart[]
  orders     Order[]

  @@map("user")
}

/// Staff role held by a user. A user without rows here is a customer only.
/// Privileged actions also need a session that passed two-factor sign-in (lib/auth/guards.ts).
model Role {
  userId      String    @map("user_id") @db.Uuid
  role        StaffRole
  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)

  user      User  @relation("RoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@map("role")
}

/// Signed-in session (Better Auth). The cookie carries a signed copy of `token`.
model AuthSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  token      String   @unique
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  /// How the session was created: email_otp, password, password_2fa (set by lib/auth/server.ts).
  authMethod String   @default("unknown") @map("auth_method")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

/// Credentials (Better Auth). Staff have a "credential" account holding a password hash;
/// customers signing in with email codes may have none.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Hash produced by Better Auth (scrypt). Never a plain password.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// One-time codes and other verification values (Better Auth). Codes are stored hashed.
model Verification {
  /// Text, not uuid: Better Auth derives some verification keys from the identifier.
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// TOTP secret and backup codes (Better Auth two-factor plugin; encrypted by Better Auth).
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

/// Request counters for Better Auth's rate limiter (database storage, shared by all instances).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

/// Anonymous shopper. The cookie holds a random token; only its SHA-256 hash is stored.
/// Owns guest carts and orders; can never hold a role or reach staff routes.
model GuestSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  carts  Cart[]
  orders Order[]

  @@index([expiresAt])
  @@map("guest_session")
}

model CustomerProfile {
  userId              String    @id @map("user_id") @db.Uuid
  fullName            String?   @map("full_name")
  /// Marketing consent with its origin, so it can be proven or withdrawn (Stage 18).
  emailMarketingOptIn Boolean   @default(false) @map("email_marketing_opt_in")
  consentSource       String?   @map("consent_source")
  consentTextVersion  String?   @map("consent_text_version")
  consentAt           DateTime? @map("consent_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profile")
}

/// Saved address book entry. Orders copy the address into a frozen snapshot instead of linking here.
/// Checked by apps/api/src/checkout/address.ts and by CHECK constraints (Stage 12.01); guests have none.
model Address {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  district  String
  /// ISO 3166-2:IN, for example IN-KA.
  stateCode String   @map("state_code")
  pinCode   String   @map("pin_code") @db.Char(6)
  country   String   @default("IN") @db.Char(2)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address")
}

// ---------------------------------------------------------------------------------------------
// Catalogue

model Collection {
  id               String   @id @default(uuid(7)) @db.Uuid
  handle           String   @unique
  title            String
  description      String   @default("")
  hidden           Boolean  @default(false)
  position         Int      @default(0)
  legacyShopifyGid String?  @unique @map("legacy_shopify_gid")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// One of the storefront's fixed category pages (/dresses, /ethnic-festive, /jewellery,
  /// /fragrance): its handle is the page URL and cannot change.
  storefront       Boolean  @default(false)
  /// Incremented on every admin change (Stage 08).
  version          Int      @default(0)

  products ProductCollection[]

  @@map("collection")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  /// Public URL handle; existing Shopify handles are kept.
  handle           String        @unique
  status           ProductStatus @default(draft)
  title            String
  description      String        @default("")
  productType      String        @default("") @map("product_type")
  tags             String[]      @default([])
  legacyShopifyGid String?       @unique @map("legacy_shopify_gid")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Incremented on every admin change; the admin ETag (Stage 08).
  version             Int                  @default(0)
  /// Courier handling class; null until reviewed. Publishing needs it.
  shippingRestriction ShippingRestriction? @map("shipping_restriction")
  /// The publish checklist the approver confirmed: { claims, pricing, description, sizing, shipping }.
  approval            Json                 @default("{}")
  approvedAt          DateTime?            @map("approved_at") @db.Timestamptz(3)
  /// Staff user who confirmed the checklist (also recorded in the audit trail).
  approvedById        String?              @map("approved_by_id") @db.Uuid

  variants    ProductVariant[]
  media       ProductMedia[]
  collections ProductCollection[]
  uploads     MediaUpload[]

  @@index([status, createdAt])
  @@map("product")
}

model ProductCollection {
  productId    String @map("product_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collection")
}

model ProductVariant {
  id                  String    @id @default(uuid(7)) @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  /// Unique among variants that are not archived (partial index in the migration).
  sku                 String
  title               String
  /// [{ name, value }] in option order.
  selectedOptions     Json      @default("[]") @map("selected_options")
  /// Normalized option combination, for example "colour=merlot|size=m"; unique per product.
  optionKey           String    @map("option_key")
  pricePaise          BigInt    @map("price_paise")
  compareAtPricePaise BigInt?   @map("compare_at_price_paise")
  currency            String    @default("INR") @db.Char(3)
  /// Drives GST rate and HSN; values need tax-advisor approval (decision 014).
  taxCategory         String    @default("unassigned") @map("tax_category")
  hsnCode             String?   @map("hsn_code")
  mediaId             String?   @map("media_id") @db.Uuid
  position            Int       @default(0)
  weightGrams         Int?      @map("weight_grams")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  legacyShopifyGid    String?   @unique @map("legacy_shopify_gid")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Incremented on every admin change (Stage 08).
  version             Int       @default(0)

  product          Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  media            ProductMedia?              @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  balance          InventoryBalance?
  movements        InventoryMovement[]
  reservationLines InventoryReservationLine[]
  stocktakeLines   StocktakeLine[]
  cartLines        CartLine[]
  orderItems       OrderItem[]

  @@unique([productId, optionKey])
  @@index([productId, position])
  @@index([sku])
  @@map("product_variant")
}

model ProductMedia {
  id               String   @id @default(uuid(7)) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  /// Public URL; null until the image is approved (Stage 08).
  url              String?
  /// Object storage key of the public copy once approved (decision 018).
  storageKey       String?  @unique @map("storage_key")
  altText          String?  @map("alt_text")
  width            Int?
  height           Int?
  contentType      String?  @map("content_type")
  byteSize         Int?     @map("byte_size")
  checksumSha256   String?  @map("checksum_sha256")
  position         Int      @default(0)
  legacyShopifyUrl String?  @map("legacy_shopify_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Stage 08: uploaded photos wait in private staging until a publisher approves them.
  status           MediaStatus @default(pending)
  /// Private staging object; deleted once the public copy exists or the photo is rejected.
  stagingKey       String?     @unique @map("staging_key")
  approvedAt       DateTime?   @map("approved_at") @db.Timestamptz(3)
  approvedById     String?     @map("approved_by_id") @db.Uuid
  /// Removed from the product; the stored objects are deleted by the worker after a grace period.
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  version          Int         @default(0)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  upload   MediaUpload?

  @@index([productId, position])
  @@index([removedAt])
  @@map("product_media")
}

/// A signed permission to upload one photo to private staging (Stage 08). The client must send
/// exactly the declared type, size and SHA-256; the API verifies the stored object before it becomes
/// product media. Unused intents expire and their objects are deleted by the worker.
model MediaUpload {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  stagingKey     String    @unique @map("staging_key")
  contentType    String    @map("content_type")
  byteSize       Int       @map("byte_size")
  /// Base64 SHA-256 of the file, as sent in the signed x-amz-checksum-sha256 header.
  checksumSha256 String    @map("checksum_sha256")
  createdById    String    @map("created_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  mediaId        String?   @unique @map("media_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   ProductMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("media_upload")
}

/// Transactional outbox (Stage 08): events written in the same transaction as the change they
/// describe and delivered by the worker at least once. Payloads carry IDs and handles only.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  topic         String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(3)

  @@index([dispatchedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------------------------
// Inventory (available = on_hand - reserved - allocated, never negative: CHECK in the migration)

model InventoryBalance {
  variantId String   @id @map("variant_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  allocated Int      @default(0)
  /// Incremented on every change, for optimistic concurrency in admin edits.
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set when an approved stocktake counted this SKU (Stage 09). Never counted: not for sale.
  lastCountedAt     DateTime? @map("last_counted_at") @db.Timestamptz(3)
  /// Low-stock notice in the admin when available falls to this number or below.
  lowStockThreshold Int?      @map("low_stock_threshold")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([lastCountedAt])
  @@map("inventory_balance")
}

/// Immutable ledger row (UPDATE and DELETE are blocked by a trigger). Corrections are new rows.
model InventoryMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  variantId      String       @map("variant_id") @db.Uuid
  type           MovementType
  /// Signed change to the bucket the type affects.
  quantity       Int
  reason         String
  actorKind      ActorKind    @map("actor_kind")
  actorId        String?      @map("actor_id")
  referenceType  String       @map("reference_type")
  referenceId    String       @map("reference_id")
  idempotencyKey String?      @unique @map("idempotency_key")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Stage 09: why, as a code (receipt, found, damaged, lost, data_entry, stocktake, expired, ...).
  reasonCode     String       @default("") @map("reason_code")
  /// Balance right after this movement, for the history view.
  onHandAfter    Int?         @map("on_hand_after")
  reservedAfter  Int?         @map("reserved_after")
  allocatedAfter Int?         @map("allocated_after")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movement")
}

model InventoryReservation {
  id             String            @id @default(uuid(7)) @db.Uuid
  orderId        String            @unique @map("order_id") @db.Uuid
  status         ReservationStatus @default(active)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  idempotencyKey String            @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines InventoryReservationLine[]

  @@index([status, expiresAt])
  @@map("inventory_reservation")
}

/// A physical stock count (Stage 09). Lines hold what was counted; on approval the API compares
/// them with the books, the approver accepts every discrepancy and signs, and corrections are
/// written to the ledger in the same transaction. Imports of stock files only ever create drafts.
/// GST configuration for checkout (Stage 12.05): the seller's registration and state, and the HSN code and
/// GST rate for each tax category. A draft is editable; an approved profile is signed by the owner with the
/// tax advisor's reference and never changes again (trigger tax_profile_frozen); only an approved profile can
/// be active, one at a time. No profile exists until the owner enters real values: until one is approved and
/// active, live sales are blocked (apps/api/src/tax/profile.ts, taxReadiness).
model TaxProfile {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// draft, approved or retired.
  status           String    @default("draft")
  active           Boolean   @default(false)
  /// ISO 3166-2:IN code of the state the seller is registered in (CGST+SGST within it, IGST outside).
  sellerStateCode  String    @map("seller_state_code")
  gstin            String?
  pricesIncludeTax Boolean   @default(true) @map("prices_include_tax")
  note             String    @default("")
  createdById      String    @map("created_by_id") @db.Uuid
  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  /// Full name typed by the approver as their signature.
  signedName       String?   @map("signed_name")
  /// The tax advisor's sign-off, for example the opinion or engagement reference and its date.
  advisorReference String?   @map("advisor_reference")
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(3)
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates TaxRate[]

  @@index([status])
  @@map("tax_profile")
}

/// One tax category's HSN code and GST rate within a profile.
model TaxRate {
  profileId       String @map("profile_id") @db.Uuid
  taxCategory     String @map("tax_category")
  hsnCode         String @map("hsn_code")
  /// GST rate in basis points (5% = 500).
  rateBasisPoints Int    @map("rate_basis_points")

  profile TaxProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, taxCategory])
  @@map("tax_rate")
}

model Stocktake {
  id            String          @id @default(uuid(7)) @db.Uuid
  status        StocktakeStatus @default(draft)
  note          String          @default("")
  /// owner_count, owner_csv or shopify_export (reference only, never trusted as stock).
  source        String          @default("owner_count")
  /// SHA-256 of an imported file: the same file always maps to the same stocktake.
  sourceSha256  String?         @unique @map("source_sha256")
  createdById   String          @map("created_by_id") @db.Uuid
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz(3)
  approvedById  String?         @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?       @map("approved_at") @db.Timestamptz(3)
  /// Full name typed by the approver as their signature.
  signedName    String?         @map("signed_name")
  /// The signed reconciliation report: every line, the books, the count, the difference, the checks.
  report        Json?
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines StocktakeLine[]

  @@index([status, createdAt])
  @@map("stocktake")
}

model StocktakeLine {
  stocktakeId String  @map("stocktake_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  counted     Int
  /// Reference figure from an imported file (for example an old Shopify quantity); never applied.
  reference   Int?
  /// Why the count differs from the books, written by staff.
  note        String  @default("")

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([stocktakeId, variantId])
  @@map("stocktake_line")
}

model InventoryReservationLine {
  reservationId String @map("reservation_id") @db.Uuid
  variantId     String @map("variant_id") @db.Uuid
  quantity      Int

  reservation InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variant     ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([reservationId, variantId])
  @@map("inventory_reservation_line")
}

// ---------------------------------------------------------------------------------------------
// Cart and promotions

/// Exactly one owner: a customer or a guest session (CHECK in the migration). Holds no stock.
model Cart {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  guestSessionId String?  @map("guest_session_id") @db.Uuid
  revision       Int      @default(0)
  /// The promo code applied to the bag (Stage 11.10): one at a time, checked again on every read.
  promotionId    String?  @map("promotion_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  promotion    Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  lines        CartLine[]
  requests     CartRequest[]
  contact      CartContact?
  quote        CheckoutQuote?
  orders       Order[]

  @@index([userId])
  @@index([guestSessionId])
  @@index([expiresAt])
  @@map("cart")
}

/// Idempotency-Key of each add to a cart (Stage 11.04): a retry with the same key changes nothing
/// and gets the bag back; the same key with a different request is refused. Deleted with the cart.
/// Who to contact and where to deliver for this bag (Stage 12.04), entered at the contact step without
/// an account. Lives and dies with the bag; cleared when a guest bag is merged at sign-in. The phone is
/// the delivery phone on the address (owner decision, 26 October 2026). No marketing consent is stored:
/// none is offered until the owner approves its wording (Stage 18).
model CartContact {
  cartId          String   @id @map("cart_id") @db.Uuid
  email           String
  /// IndianAddressV1, checked by apps/api/src/checkout/address.ts.
  shippingAddress Json     @map("shipping_address")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_contact")
}

/// The latest checkout quote for a bag (Stage 12.09), worked out on the server; replaced on every quote.
/// The order's event trail (Stage 13.08): append-only, written by the database for every status move and by
/// the API for the placement. Each event names its origin (actor, correlation id); nothing personal.
model OrderEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  /// placed | status | fulfilment | payment | reservation | hold
  kind          String
  /// The order, payment attempt or stock hold that moved.
  subjectId     String    @map("subject_id") @db.Uuid
  fromState     String?   @map("from_state")
  toState       String    @map("to_state")
  actorKind     ActorKind @map("actor_kind")
  actorId       String?   @map("actor_id")
  correlationId String    @map("correlation_id")
  reason        String    @default("")
  /// Redacted context only (enforced by order_event_context_redacted).
  context       Json      @default("{}")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@index([correlationId])
  @@map("order_event")
}

/// Staff actions on an order (Stage 13.13): holds, releases and internal notes. Append-only. A note's
/// text is internal and never shown to the buyer; the audit trail records only its id and length.
model OrderAdminAction {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  /// hold | release | note
  kind           String
  actorId        String   @map("actor_id") @db.Uuid
  /// The staff reason for a hold or release, or the note's text.
  body           String
  /// "staff:<actor id>:<Idempotency-Key>": a retry with the same key changes nothing.
  idempotencyKey String?  @unique @map("idempotency_key")
  correlationId  String   @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_admin_action")
}

/// A stuck order found by order reconciliation (Stage 13.14), for a person to look at. Opening a case never
/// changes the order, its payments or its stock hold. Facts are statuses, ids and times only: nothing personal.
model OrderRecoveryCase {
  id           String    @id @default(uuid(7)) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  /// pending_past_window | captured_not_confirmed | hold_overdue | hold_mismatch | review_waiting
  kind         String
  /// open | resolved (by staff, with a reason) | cleared (the condition no longer holds)
  status       String    @default("open")
  /// What was seen: order, payment and hold statuses and deadlines.
  facts        Json
  /// SHA-256 of the facts: a resolved case is not reopened while the facts stay the same.
  factsKey     String    @map("facts_key") @db.Char(64)
  /// What a person should check first; never a payment outcome.
  check        String
  detectedAt   DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy     String?   @map("closed_by") @db.Uuid
  resolution   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, detectedAt])
  @@index([orderId])
  /// One open case per order and kind: a partial unique index in migration 20261030010000_order_recovery_cases, not modelled here.
  @@map("order_recovery_case")
}

model CheckoutQuote {
  id                 String   @id @db.Uuid
  cartId             String   @unique @map("cart_id") @db.Uuid
  cartRevision       Int      @map("cart_revision")
  grandTotalPaise    BigInt   @map("grand_total_paise")
  currency           String   @default("INR") @db.Char(3)
  /// True for sandbox delivery rates or an unapproved tax profile: never a real order.
  test               Boolean
  /// CheckoutQuoteV1 as the shopper saw it.
  quote              Json
  /// Digest of the guest session or customer the quote belongs to (Stage 12.10); never the id itself.
  ownerHash          String   @map("owner_hash") @db.Char(64)
  /// SHA-256 over the owner and every bound part (apps/api/src/checkout/quote-fingerprint.ts).
  fingerprint        String   @db.Char(64)
  fingerprintVersion Int      @map("fingerprint_version")
  /// One digest per bound part, so a refusal can name what changed.
  parts              Json
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("checkout_quote")
}

model CartRequest {
  cartId        String   @map("cart_id") @db.Uuid
  key           String
  requestSha256 String   @map("request_sha256")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@id([cartId, key])
  @@map("cart_request")
}

/// No price column: prices are read from the catalogue on every display and at quote time.
model CartLine {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_line")
}

model Promotion {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// Stored upper-case.
  code               String        @unique
  kind               PromotionKind
  percentBasisPoints Int?          @map("percent_basis_points")
  amountOffPaise     BigInt?       @map("amount_off_paise")
  minSubtotalPaise   BigInt?       @map("min_subtotal_paise")
  currency           String        @default("INR") @db.Char(3)
  startsAt           DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?     @map("ends_at") @db.Timestamptz(3)
  usageLimit         Int?          @map("usage_limit")
  perCustomerLimit   Int?          @map("per_customer_limit")
  usageCount         Int           @default(0) @map("usage_count")
  active             Boolean       @default(false)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]
  carts  Cart[]

  @@map("promotion")
}

// ---------------------------------------------------------------------------------------------
// Orders (number format is decision 016, still proposed)

model Order {
  id                     String           @id @default(uuid(7)) @db.Uuid
  number                 String           @unique @default(dbgenerated("('CHV-'::text || nextval('order_number_seq'::regclass))"))
  userId                 String?          @map("user_id") @db.Uuid
  guestSessionId         String?          @map("guest_session_id") @db.Uuid
  email                  String
  status                 OrderStatus      @default(pending_payment)
  fulfilmentStatus       FulfilmentStatus @default(unfulfilled) @map("fulfilment_status")
  quoteRef               String?          @map("quote_ref")
  promotionId            String?          @map("promotion_id") @db.Uuid
  subtotalPaise          BigInt           @map("subtotal_paise")
  discountTotalPaise     BigInt           @default(0) @map("discount_total_paise")
  shippingFeePaise       BigInt           @default(0) @map("shipping_fee_paise")
  taxTotalPaise          BigInt           @default(0) @map("tax_total_paise")
  grandTotalPaise        BigInt           @map("grand_total_paise")
  currency               String           @default("INR") @db.Char(3)
  pricesIncludeTax       Boolean          @default(true) @map("prices_include_tax")
  /// Frozen copies (IndianAddressV1); later address-book edits never change an order.
  shippingAddress        Json             @map("shipping_address")
  billingAddress         Json?            @map("billing_address")
  /// Idempotency key of the checkout confirmation: the same key returns the same order.
  submitKey              String           @unique @map("submit_key")
  legacyShopifyOrderName String?          @unique @map("legacy_shopify_order_name")
  /// Stage 13.01: who bought it, as placed: { kind, email, name, phone }. NULL only for orders not placed from a quote.
  customerSnapshot       Json?            @map("customer_snapshot")
  /// The tax basis: { taxProfileId, profileApproved, supply, seller and delivery states, pricesIncludeTax, rounding }.
  taxSnapshot            Json?            @map("tax_snapshot")
  /// The delivery option sold: { serviceRef, courierName, mode, estimatedDeliveryDays, fee, tax, total, ratesMode }.
  shippingSnapshot       Json?            @map("shipping_snapshot")
  /// Fingerprint of the quote the order was placed from (Stage 12.10).
  quoteFingerprint       String?          @map("quote_fingerprint") @db.Char(64)
  /// The bag the order was placed from (Stage 13.03); cleared if the bag is deleted.
  cartId                 String?          @map("cart_id") @db.Uuid
  /// When the order's price stops being payable: the quote's expiry (Stage 13.03).
  payableUntil           DateTime?        @map("payable_until") @db.Timestamptz(3)
  /// Staff hold (Stage 13.13): while set, fulfilment cannot move forward (the database refuses it); only cancelling can.
  heldAt                 DateTime?        @map("held_at") @db.Timestamptz(3)
  /// The staff member who placed the hold.
  heldBy                 String?          @map("held_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestSession GuestSession?         @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  promotion    Promotion?            @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  cart         Cart?                 @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  reservation  InventoryReservation?
  payments     PaymentAttempt[]
  shipments    Shipment[]
  returns      ReturnRequest[]
  adminActions OrderAdminAction[]
  recoveryCases OrderRecoveryCase[]

  @@index([userId, createdAt])
  @@index([guestSessionId])
  @@index([status, createdAt])
  @@index([email])
  @@index([cartId])
  /// One order per checkout quote (Stage 13.02); a partial unique index in migration 20261028010000_order_one_per_quote, not modelled here.
  @@map("order")
}

/// Frozen snapshot of what was bought. Catalogue edits or deletions never change it.
model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  /// Kept for reporting; set to null if the variant is ever deleted. The snapshot stays.
  variantId      String?  @map("variant_id") @db.Uuid
  sku            String
  productTitle   String   @map("product_title")
  variantTitle   String   @map("variant_title")
  handle         String
  imageUrl       String?  @map("image_url")
  hsnCode        String?  @map("hsn_code")
  quantity       Int
  unitPricePaise BigInt   @map("unit_price_paise")
  discountPaise  BigInt   @default(0) @map("discount_paise")
  taxPaise       BigInt   @default(0) @map("tax_paise")
  /// TaxLineV1[] at the time of purchase.
  taxLines       Json     @default("[]") @map("tax_lines")
  lineTotalPaise BigInt   @map("line_total_paise")
  /// TaxClassificationV1 at the time of purchase (Stage 13.01).
  taxClassification Json? @map("tax_classification")
  currency       String   @default("INR") @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_item")
}

// ---------------------------------------------------------------------------------------------
// Payments (authority: the provider; these rows mirror it)

model PaymentAttempt {
  id                  String          @id @default(uuid(7)) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  provider            PaymentProvider
  mode                PaymentMode
  amountPaise         BigInt          @map("amount_paise")
  currency            String          @default("INR") @db.Char(3)
  providerOrderId     String?         @unique @map("provider_order_id")
  providerPaymentId   String?         @unique @map("provider_payment_id")
  status              PaymentStatus   @default(created)
  capturedAmountPaise BigInt?         @map("captured_amount_paise")
  idempotencyKey      String          @unique @map("idempotency_key")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds        Refund[]
  reconciliation PaymentReconciliation?

  @@index([orderId])
  @@index([status, updatedAt])
  /// Stage 14.03 (migration 20261031000000_payment_attempt_identity, not modelled here): one attempt in progress per
  /// order (partial unique index); created for the order's own total in INR; identity and provider references fixed once set; never deleted.
  @@map("payment_attempt")
}

/// Stage 14.14: the payment reconciliation job's record for one payment attempt whose outcome it asks the
/// provider about: how often it asked, what it found last, the last recoverable error, and when it may ask
/// again (backing off). Migration 20261031020000_payment_reconciliation keeps checks counting up and rows kept.
model PaymentReconciliation {
  attemptId     String    @id @map("attempt_id") @db.Uuid
  checks        Int       @default(0)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  lastOutcome   String?   @map("last_outcome")
  lastError     String?   @map("last_error")
  nextCheckAt   DateTime  @default(now()) @map("next_check_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([nextCheckAt])
  @@map("payment_reconciliation")
}

/// Stage 14.10: every verified payment webhook, kept once by (provider, event_id) with where it is in its
/// processing. Only the normalized, provider-neutral event is kept, never the raw body or its signature.
/// Migration 20261031010000_payment_webhook_inbox adds what is not modelled here: the event's fields never
/// change, status moves only forward (received, processing, processed or failed; failed and processed are
/// final), a conflicting delivery is noted once, and rows are never deleted.
model PaymentWebhookInbox {
  id                String             @id @default(uuid(7)) @db.Uuid
  provider          PaymentProvider
  eventId           String             @map("event_id")
  fingerprint       String
  type              String
  providerOrderId   String             @map("provider_order_id")
  providerPaymentId String?            @map("provider_payment_id")
  providerRefundId  String?            @map("provider_refund_id")
  amountPaise       BigInt             @map("amount_paise")
  currency          String             @default("INR") @db.Char(3)
  occurredAt        DateTime           @map("occurred_at") @db.Timestamptz(3)
  status            WebhookInboxStatus @default(received)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimId           String?            @map("claim_id") @db.Uuid
  lockedUntil       DateTime?          @map("locked_until") @db.Timestamptz(3)
  lastError         String?            @map("last_error")
  conflictAt        DateTime?          @map("conflict_at") @db.Timestamptz(3)
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, nextAttemptAt])
  @@map("payment_webhook_inbox")
}

/// Every verified webhook or lookup, once. (provider, event_id) is unique, so a replay cannot
/// insert twice. Only a redacted summary is kept, never raw bodies or signatures.
model ProviderEvent {
  id          String                @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String                @map("event_id")
  fingerprint String
  type        String
  outcome     ProviderEventOutcome?
  summary     Json                  @default("{}")
  receivedAt  DateTime              @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?             @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("provider_event")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentAttemptId String       @map("payment_attempt_id") @db.Uuid
  amountPaise      BigInt       @map("amount_paise")
  currency         String       @default("INR") @db.Char(3)
  status           RefundStatus @default(requested)
  reason           String
  requestedByKind  ActorKind    @map("requested_by_kind")
  requestedById    String?      @map("requested_by_id")
  providerRefundId String?      @unique @map("provider_refund_id")
  idempotencyKey   String       @unique @map("idempotency_key")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  returnRequest  ReturnRequest?

  @@index([paymentAttemptId])
  @@map("refund")
}

// ---------------------------------------------------------------------------------------------
// Shipping (authority for parcel location: courier scans)

model Shipment {
  id                 String          @id @default(uuid(7)) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  provider           CourierProvider
  providerShipmentId String?         @unique @map("provider_shipment_id")
  courierName        String?         @map("courier_name")
  awb                String?         @unique
  status             ShipmentStatus  @default(booking_requested)
  /// ParcelV1[]: weights, dimensions and items.
  parcels            Json            @default("[]")
  shippingCostPaise  BigInt?         @map("shipping_cost_paise")
  currency           String          @default("INR") @db.Char(3)
  trackingUrl        String?         @map("tracking_url")
  /// Idempotency key of the booking request: one booking per key.
  bookingKey         String          @unique @map("booking_key")
  isReturnPickup     Boolean         @default(false) @map("is_return_pickup")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events        ShipmentTrackingEvent[]
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([status, updatedAt])
  @@map("shipment")
}

model ShipmentTrackingEvent {
  id                String         @id @default(uuid(7)) @db.Uuid
  shipmentId        String         @map("shipment_id") @db.Uuid
  /// Courier event ID, or a hash of (AWB, status code, timestamp).
  eventId           String         @map("event_id")
  status            ShipmentStatus
  courierStatusCode String         @map("courier_status_code")
  location          String?
  occurredAt        DateTime       @map("occurred_at") @db.Timestamptz(3)
  receivedAt        DateTime       @default(now()) @map("received_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, eventId])
  @@index([shipmentId, occurredAt])
  @@map("shipment_tracking_event")
}

// ---------------------------------------------------------------------------------------------
// Returns (customer-initiated only; RTO is a shipment outcome)

model ReturnRequest {
  id                      String       @id @default(uuid(7)) @db.Uuid
  orderId                 String       @map("order_id") @db.Uuid
  status                  ReturnStatus @default(requested)
  reason                  String
  customerMessage         String?      @map("customer_message")
  reversePickupShipmentId String?      @unique @map("reverse_pickup_shipment_id") @db.Uuid
  refundId                String?      @unique @map("refund_id") @db.Uuid
  idempotencyKey          String       @unique @map("idempotency_key")
  requestedAt             DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reversePickupShipment Shipment?    @relation(fields: [reversePickupShipmentId], references: [id], onDelete: Restrict)
  refund                Refund?      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  items                 ReturnItem[]

  @@index([orderId])
  @@index([status, updatedAt])
  @@map("return_request")
}

model ReturnItem {
  returnId    String   @map("return_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  quantity    Int
  /// Set at inspection; restocking is a separate inventory movement.
  restockable Boolean?

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([returnId, orderItemId])
  @@map("return_item")
}

// ---------------------------------------------------------------------------------------------
// Audit (append-only: UPDATE and DELETE are blocked by a trigger)

model AuditEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  action        String
  actorKind     ActorKind @map("actor_kind")
  actorId       String?   @map("actor_id")
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  /// Transition precondition ID or staff reason code.
  reason        String
  /// Redacted summaries only.
  before        Json?
  after         Json?
  correlationId String    @map("correlation_id")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([entityType, entityId, occurredAt])
  @@index([occurredAt])
  @@index([correlationId])
  @@map("audit_event")
}
